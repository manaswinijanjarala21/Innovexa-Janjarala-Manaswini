pipeline {
    agent any

    stages {

        stage('Git Checkout') {
            steps {
                checkout scm
            }
        }

        stage('JUnit Test') {
            steps {
                sh 'mvn test'
            }
        }

        stage('Maven Build') {
            steps {
                sh 'mvn clean package -DskipTests'
            }
        }

        stage('Gitleaks') {
            steps {
                sh 'gitleaks detect --source . --no-banner'
            }
        }

        stage('Docker Image Build') {
            steps {
                sh 'docker build -t innovexa-app:latest .'
            }
        }

        stage('Trivy Scan') {
            steps {
                sh 'trivy image --severity HIGH,CRITICAL innovexa-app:latest'
            }
        }

        stage('Docker Run') {
            steps {
                sh '''
                    docker rm -f innovexa-app || true
                    docker run -d --name innovexa-app -p 8081:8080 innovexa-app:latest
                '''
            }
        }
    }
}
